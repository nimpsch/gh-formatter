{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "typecheck:watch",
      "label": "watch:tsc",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": { "reveal": "never", "group": "watch" }
    },
    {
      "type": "npm",
      "script": "watch:esbuild",
      "label": "watch:esbuild",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "applyTo": "closedDocuments",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^✘ \\[ERROR\\] (.+)$",
            "message": 1
          },
          {
            "regexp": "^\\s+(.+):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      },
      "presentation": { "reveal": "never", "group": "watch" }
    },
    {
      "label": "watch",
      "dependsOn": ["watch:tsc", "watch:esbuild"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
